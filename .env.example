# Copy to .env and fill in. Never commit the real .env file.

# LLM provider — pick one, wire it up in src/mira/llm/client.py
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# STT/TTS provider keys, if using cloud services instead of local models
STT_API_KEY=
TTS_API_KEY=

# Display server
MIRA_DISPLAY_PORT=8000
