# Copy to .env and fill in. Never commit the real .env file.

# LLM provider — pick one, wire it up in src/mira/llm/client.py
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# STT/TTS provider keys, if using cloud services instead of local models
STT_API_KEY=
TTS_API_KEY=

# Dexcom API (sandbox). Get these from your app on developer.dexcom.com.
# Use https://api.dexcom.com for production.
DEXCOM_BASE_URL=https://sandbox-api.dexcom.com
DEXCOM_CLIENT_ID=
DEXCOM_CLIENT_SECRET=
DEXCOM_REDIRECT_URI=http://localhost:8000/callback
DEXCOM_REFRESH_TOKEN=

# Display server
MIRA_DISPLAY_PORT=8000
